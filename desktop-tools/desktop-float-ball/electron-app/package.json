{
  "name": "desktop-float-ball-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Experimental desktop float bubble translator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win nsis",
    "pack:win-dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "ws": "8.21.0"
  },
  "build": {
    "appId": "com.desktopfloatball.test",
    "productName": "DesktopFloatBallTest",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
