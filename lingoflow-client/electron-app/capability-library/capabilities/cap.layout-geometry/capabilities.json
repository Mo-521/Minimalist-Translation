            "independent-region",
            "tight-object-box"
          ]
        },
        {
          "id": "boundary.geometry.protected-object",
          "description": "References 等保护区域与正文空间分离记录。",
          "featureTags": [
            "protected-region",
            "references"
          ]
        },
        {
          "id": "boundary.geometry.column-dependency",
          "description": "只引用已冻结的 canonical Column lane，不重判栏型。",
