{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minimalist-translation.local/schemas/capability-library-v2.json",
  "title": "Capability Library Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogRole", "runtimeDecisionUse", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "capability-library/v2" },
    "catalogRole": { "const": "evidence_and_regression_only" },
    "runtimeDecisionUse": { "const": "forbidden" },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
  },
  "$defs": {
    "factId": { "type": "string", "pattern": "^fact\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "capabilityId": { "type": "string", "pattern": "^cap\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "displayName", "description", "recordKind", "domain", "responsibilities", "architectureRecord", "decisionAuthority", "status", "dependencies", "boundaries", "expectedOutcomes", "evidenceRequirements", "regressionSampleIds"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "recordKind": { "enum": ["independent_capability", "acceptance_contract", "derived_status", "historical_compatibility"] },
        "domain": { "enum": ["document-structure-identity", "column-region-recognition", "content-placement", "layout-composition", "export-validation"] },
        "responsibilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "architectureRecord": { "type": "string", "pattern": "^AA-[A-Z]+-[0-9]{3}$" },
        "relatedArchitectureRecords": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^AA-[A-Z]+-[0-9]{3}$" } },
        "decisionAuthority": {
          "type": "object", "additionalProperties": false, "required": ["owner", "statement"],
          "properties": { "owner": { "type": "string", "minLength": 1 }, "statement": { "type": "string", "minLength": 1 } }
        },
        "status": { "enum": ["defined", "pilot_ready", "covered", "deprecated"] },
        "dependencies": {
          "type": "object", "additionalProperties": false,
          "required": ["requires", "produces", "consumed_by", "forbidden_to_override"],
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["capabilityId", "facts", "semantics"],
                "properties": {
                  "capabilityId": { "$ref": "#/$defs/capabilityId" },
                  "facts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/factId" } },
                  "semantics": { "const": "canonical_read_only" }
                }
              }
            },
            "produces": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["factId", "authority", "description"],
                "properties": {
                  "factId": { "$ref": "#/$defs/factId" },
                  "authority": { "type": "string", "pattern": "^AA-[A-Z]+-[0-9]{3}$" },
                  "description": { "type": "string", "minLength": 1 }
                }
              }
            },
            "consumed_by": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["capabilityId", "facts"],
                "properties": {
                  "capabilityId": { "$ref": "#/$defs/capabilityId" },
                  "facts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/factId" } }
                }
              }
            },
            "forbidden_to_override": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["authority", "facts", "reason"],
                "properties": {
                  "authority": { "type": "string", "pattern": "^AA-[A-Z]+-[0-9]{3}$" },
                  "facts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/factId" } },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "description", "featureTags"],
            "properties": {
              "id": { "type": "string", "pattern": "^boundary\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
              "description": { "type": "string", "minLength": 1 },
              "featureTags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "expectedOutcomes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "assertion", "evidenceLevel"],
            "properties": {
              "id": { "type": "string", "pattern": "^assert\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
              "assertion": { "type": "string", "minLength": 1 },
              "evidenceLevel": { "enum": ["unit_contract", "artifact", "real_run", "pixel_visual", "user_acceptance"] }
            }
          }
        },
        "evidenceRequirements": { "type": "array", "uniqueItems": true, "items": { "enum": ["unit_contract", "artifact", "real_run", "pixel_visual", "user_acceptance"] } },
        "regressionSampleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^sample\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" } }
      }
    }
  }
}
