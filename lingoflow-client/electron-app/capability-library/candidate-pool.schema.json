{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minimalist-translation.local/schemas/capability-candidate-pool-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "catalogRole", "runtimeDecisionUse", "candidates"],
  "properties": {
    "schemaVersion": {"const": "capability-candidate-pool/v1"},
    "catalogRole": {"const": "candidate_evidence_only"},
    "runtimeDecisionUse": {"const": "forbidden"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "capabilityIds", "sample", "status", "promotedSampleId", "history"],
      "properties": {
        "id": {"type": "string", "pattern": "^candidate\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "capabilityIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^cap\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"}},
        "sample": {"$ref": "https://minimalist-translation.local/schemas/capability-corpus-v1.json#/$defs/sample"},
        "status": {"enum": ["pending", "under_review", "accepted", "insufficient_evidence"]},
        "promotedSampleId": {"type": ["string", "null"]},
        "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "action", "actor", "at", "reason", "from", "to", "evidenceRefs", "expectedOutcomes", "sampleHash", "previousHash", "hash"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "action": {"enum": ["submit", "review", "promote"]},
        "actor": {"type": "string", "minLength": 1},
        "at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
        "reason": {"type": "string", "minLength": 1},
        "from": {"type": ["string", "null"]},
        "to": {"enum": ["pending", "under_review", "accepted", "insufficient_evidence"]},
        "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expectedOutcomes": {"$ref": "https://minimalist-translation.local/schemas/capability-corpus-v1.json#/$defs/sample/properties/expectedOutcomes"},
        "sampleHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "previousHash": {"type": ["string", "null"]},
        "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
