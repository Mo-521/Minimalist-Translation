{
  "name": "lingoflow-electron",
  "version": "1.1.1",
  "private": true,
  "description": "Local-first Electron client for desktop and PDF translation",
  "main": "main.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o tailwind.css --minify",
    "start": "npm run build:css && electron .",
    "test:pdf": "node --test ../tests/pdf/unit/*.test.js",
    "capability:intake": "node ../tools/capability-library-intake.js",
    "capability:candidates": "node ../tools/capability-candidate-pool.js",
    "pack:win": "npm run build:css && electron-builder --win nsis",
    "pack:win-dir": "npm run build:css && electron-builder --win dir"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.10",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "ajv": "8.20.0",
    "docx": "9.7.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "build": {
    "appId": "com.minimalisttranslation.client",
    "productName": "Minimalist Translation",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "renderer.js",
      "provider-help-content.js",
      "styles.css",
      "tailwind.css",
      "paper-layout-authority.js",
      "column-authority.js",
      "pdf-pipeline-diagnostics.js",
      "semantic-structure-authority.js",
      "semantic-structure-consumer-authority.js",
      "capability-library/index.js",
      "capability-library/schemas/domain.schema.json",
      "capability-library/registry/domains.json",
      "capability-library/schemas/capability.schema.json",
      "capability-library/schemas/capability.v1.schema.json",
      "capability-library/schemas/sample-corpus.schema.json",
      "capability-library/registry/capabilities.json",
      "capability-library/shared/corpus.json",
      "capability-library/domains/*/capabilities/*/capabilities.json",
      "capability-library/domains/*/capabilities/*/corpus.json",
      "capability-library/domains/*/capabilities/*/batches/B*/manifest.json",
      "capability-library/domains/document-structure-identity/capabilities/cap.document-structure/integration/shadow-runtime.cjs",
      "capability-library/domains/document-structure-identity/capabilities/cap.document-structure/integration/object-first-contract.cjs",
      "capability-library/domains/document-structure-identity/capabilities/cap.document-structure/offline/*.cjs",
      "!capability-library/domains/document-structure-identity/capabilities/cap.document-structure/offline/*.test.cjs",
      "capability-library/domains/document-structure-identity/capabilities/cap.document-structure/offline/pdf-evidence/*.py",
      "package.json",
      "node_modules/**/*",
      "!node_modules/fast-uri/benchmark/**"
    ],
    "asarUnpack": [
      "capability-library/domains/document-structure-identity/capabilities/cap.document-structure/offline/pdf-evidence/*.py"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Minimalist-Translation-Setup-${version}.${ext}"
    }
  }
}
